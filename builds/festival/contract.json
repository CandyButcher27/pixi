{
  "required": [
    {
      "rule": "full_bleed_sections",
      "op": ">=",
      "value": 1,
      "source": "outlier:supabase",
      "why": "at least one section breaks the page container"
    },
    {
      "rule": "centroid_flips",
      "op": ">=",
      "value": 2,
      "source": "outlier:supabase",
      "why": "visual anchor alternates sides between major sections"
    },
    {
      "rule": "display_dominance",
      "op": ">=",
      "value": 3.6,
      "source": "near:runwayml",
      "why": "display typography carries the hierarchy instead of card chrome"
    },
    {
      "rule": "max_radius",
      "op": "<=",
      "value": 20,
      "source": "contrast:terminal+outlier:supabase",
      "why": "geometry stays inside the reference range"
    }
  ],
  "forbidden": [
    {
      "rule": "gradients",
      "op": "<=",
      "value": 0,
      "source": "slop_law",
      "why": "gradient backdrops are the loudest AI tell"
    },
    {
      "rule": "pill_controls",
      "op": "<=",
      "value": 0,
      "source": "slop_law",
      "why": "fully rounded pill CTAs"
    },
    {
      "rule": "glass_panels",
      "op": "<=",
      "value": 0,
      "source": "slop_law",
      "why": "glassmorphism panels"
    },
    {
      "rule": "generic_display_font",
      "op": "==",
      "value": false,
      "source": "slop_law",
      "why": "Inter / system-ui defaults on the display face"
    },
    {
      "rule": "hero_asymmetry",
      "op": ">=",
      "value": 0.08,
      "source": "slop_law",
      "why": "centred hero column is the default AI composition"
    }
  ]
}